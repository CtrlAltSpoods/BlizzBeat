# ---------------------------------------------------------------------------
# Blizzbeat configuration. Copy this file to .env and fill in DISCORD_TOKEN.
# ---------------------------------------------------------------------------

# Required: bot token from https://discord.com/developers/applications (Bot > Reset Token)
DISCORD_TOKEN=

# Optional: register slash commands to one server instantly while testing.
# Leave empty to register globally (usually live within a minute).
DEV_GUILD_ID=

# Typing song names in the Blizzbeat channel needs the "Message Content Intent"
# turned on in the Developer Portal (Bot > Privileged Gateway Intents).
# Set to false to run with /play only.
ENABLE_MESSAGE_CONTENT=true

# --- Spotify (optional) -----------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and paste its ID/secret.
# Spotify links/searches are matched to the same song on YouTube for playback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=US

# --- YouTube -------------------------------------------------------------------
# How YouTube is played: "plugin" (Lavalink's YouTube plugin, default) or "ytdlp" (yt-dlp).
# You can also switch from Discord with /config youtube, which overrides this.
YOUTUBE_BACKEND=plugin
# Opus bitrate for songs from yt-dlp sites whose audio isn't Opus already (Opus is passed through untouched).
MEDIA_OPUS_BITRATE=256k
# If songs fail with "Sign in to confirm you're not a bot", run /config youtube -> Sign in
# in Discord (use a spare Google account). The sign-in is saved in /data and survives restarts.
# Leave empty for the tested default (a youtube-source build that fixes "The page needs to be
# reloaded"). Set a release number (e.g. 1.19.0) or a 40-char commit hash to override.
YOUTUBE_PLUGIN_VERSION=
# A small helper (yt-cipher) runs inside the container to decode YouTube's stream signatures.
# Set to false to turn it off, or set YOUTUBE_REMOTE_CIPHER_URL to use your own instead.
YOUTUBE_BUILTIN_CIPHER=true
# Clients tried in order. TV is the one that uses the signed-in account.
YOUTUBE_CLIENTS=MUSIC,TV,ANDROID_VR,WEB,WEBEMBEDDED
# Advanced alternatives (see the youtube-source README):
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_REMOTE_CIPHER_URL=
YOUTUBE_REMOTE_CIPHER_PASSWORD=

# LavaSrc plugin version (Spotify support). Leave empty to use the default / auto-updates.
LAVASRC_VERSION=

# --- Defaults for new servers (each server can change these with /config) ---
# 100 = original audio quality (no re-encoding). Listeners can lower it with Discord's own slider.
DEFAULT_VOLUME=100
MAX_VOLUME=150
DEFAULT_MAX_QUEUE=500
DEFAULT_AUTO_LEAVE_MINUTES=5
# ytmsearch (YouTube Music), ytsearch (YouTube), scsearch (SoundCloud), spsearch (Spotify)
DEFAULT_SEARCH_SOURCE=ytmsearch
DEFAULT_EMBED_COLOR=5BC0F8
# Per-person cooldowns in seconds (0 = off). Admins are never limited.
DEFAULT_REQUEST_COOLDOWN=3
DEFAULT_CONTROL_COOLDOWN=0

# How often the progress bar on the player refreshes (seconds, 5-120)
PROGRESS_UPDATE_SECONDS=10

# After a restart, resume saved queues that are at most this old (minutes, 0 = no limit).
# Servers in 24/7 mode are always restored.
RESTORE_MAX_AGE_MINUTES=60

# --- Updates ----------------------------------------------------------------
# On launch and daily, check for newer Lavalink / YouTube plugin / LavaSrc releases and switch to them
# (restarting Lavalink only while nothing is playing; rolled back automatically if they don't load).
AUTO_UPDATE=true

# --- Advanced ---------------------------------------------------------------
# Audio buffer in ms (decoded audio Lavalink keeps ready). Change it in Discord with /config buffer.
LAVALINK_FRAME_BUFFER_MS=1000
# User/group the bot runs as (owns /data). Unraid: PUID=99 PGID=100.
PUID=1000
PGID=1000
# Memory for the built-in Lavalink (Java)
JAVA_OPTS=-Xms128m -Xmx512m
# Lavalink is only reachable inside the container; a random password is generated if empty.
LAVALINK_PASSWORD=
LOG_LEVEL=info
