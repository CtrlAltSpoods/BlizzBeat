# ---------------------------------------------------------------------------
# Blizzbeat configuration. Copy this file to .env and fill in DISCORD_TOKEN.
# ---------------------------------------------------------------------------

# Required: bot token from https://discord.com/developers/applications (Bot > Reset Token)
DISCORD_TOKEN=

# Optional: register slash commands to one server instantly while testing.
# Leave empty to register globally (usually live within a minute).
DEV_GUILD_ID=

# Typing song names in the Blizzbeat channel needs the "Message Content Intent"
# turned on in the Developer Portal (Bot > Privileged Gateway Intents).
# Set to false to run with /play only.
ENABLE_MESSAGE_CONTENT=true

# --- Spotify (optional) -----------------------------------------------------
# Create an app at https://developer.spotify.com/dashboard and paste its ID/secret.
# Spotify links/searches are matched to the same song on YouTube for playback.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_COUNTRY_CODE=US

# --- YouTube (optional, only if YouTube playback starts failing) -------------
# YouTube changes often. First fix: bump YOUTUBE_PLUGIN_VERSION to the latest
# release at https://github.com/lavalink-devs/youtube-source/releases and restart.
YOUTUBE_PLUGIN_VERSION=1.18.2
# Clients tried in order. Leave as-is unless the youtube-source README says otherwise.
YOUTUBE_CLIENTS=MUSIC,ANDROID_VR,WEB,WEBEMBEDDED
# Sign in with a burner Google account to get past "confirm you're not a bot".
# First run: set ENABLED=true, watch the logs for a google.com/device code, then
# copy the refresh token it prints into YOUTUBE_OAUTH_REFRESH_TOKEN.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
# Alternatives to OAuth (see the youtube-source README):
YOUTUBE_PO_TOKEN=
YOUTUBE_VISITOR_DATA=
YOUTUBE_REMOTE_CIPHER_URL=
YOUTUBE_REMOTE_CIPHER_PASSWORD=

# LavaSrc plugin version (Spotify support)
LAVASRC_VERSION=4.8.3

# --- Defaults for new servers (each server can change these with /config) ---
DEFAULT_VOLUME=50
MAX_VOLUME=150
DEFAULT_MAX_QUEUE=500
DEFAULT_AUTO_LEAVE_MINUTES=5
# ytmsearch (YouTube Music), ytsearch (YouTube), scsearch (SoundCloud), spsearch (Spotify)
DEFAULT_SEARCH_SOURCE=ytmsearch
DEFAULT_EMBED_COLOR=5BC0F8
# Per-person cooldowns in seconds (0 = off). Admins are never limited.
DEFAULT_REQUEST_COOLDOWN=3
DEFAULT_CONTROL_COOLDOWN=0

# How often the progress bar on the player refreshes (seconds, 5-120)
PROGRESS_UPDATE_SECONDS=10

# After a restart, resume saved queues that are at most this old (minutes, 0 = no limit).
# Servers in 24/7 mode are always restored.
RESTORE_MAX_AGE_MINUTES=60

# --- Advanced ---------------------------------------------------------------
# User/group the bot runs as (owns /data). Unraid: PUID=99 PGID=100.
PUID=1000
PGID=1000
# Memory for the built-in Lavalink (Java)
JAVA_OPTS=-Xms128m -Xmx512m
# Lavalink is only reachable inside the container; a random password is generated if empty.
LAVALINK_PASSWORD=
LOG_LEVEL=info
